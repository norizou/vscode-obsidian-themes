  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8A8168", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "meta.template.expression"],
      "settings": { "foreground": "#B8860B" }
    },
    {
      "name": "String escape / regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class"],
      "settings": { "foreground": "#E60033" }
    },
    {
      "name": "Number / Boolean / Null",
      "scope": ["constant.numeric", "constant.language", "keyword.other.unit"],
      "settings": { "foreground": "#C41E3A" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#0055A5" }
    },
    {
      "name": "Operator / Punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#64748B" }
    },
    {
      "name": "Function / Method",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#0072B5" }
    },
    {
      "name": "Class / Type / Interface",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.interface", "entity.name.trait", "storage.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#003A70" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#1F2933" }
    },
    {
      "name": "Property / Object key",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name", "variable.other.object.property"],
      "settings": { "foreground": "#005580" }
    },
    {
      "name": "Constant / Enum / Symbol",
      "scope": ["constant.other", "variable.other.constant", "constant.other.symbol", "entity.name.constant"],
      "settings": { "foreground": "#C41E3A" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#3D4A55" }
    },
    {
      "name": "Tag (HTML/XML/JSX)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#0055A5" }
    },
    {
      "name": "Attribute name",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#B8860B" }
    },
    {
      "name": "Support builtin",
      "scope": ["support.constant", "support.variable", "variable.language", "entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#0068A8" }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#0055A5", "fontStyle": "bold" }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#003A70", "fontStyle": "bold" }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#0072B5", "fontStyle": "italic" }
    },
    {
      "name": "Markup Inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#B8860B", "background": "#F6ECD6" }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8A8168", "fontStyle": "italic" }
    },
    {
      "name": "Markup Link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#0055A5", "fontStyle": "underline" }
    },
    {
      "name": "Markup List",
      "scope": ["markup.list", "beginning.punctuation.definition.list"],
      "settings": { "foreground": "#0055A5" }
    },
    {
      "name": "Diff inserted / deleted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#1E8E3E" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E60033" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#0092E1" }
    },
    {
      "name": "Invalid / Error",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#E60033", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "class": "#003A70",
    "class.readonly": "#003A70",
    "enum": "#003A70",
    "enumMember": "#C41E3A",
    "function": "#0072B5",
    "function.declaration": "#0072B5",
    "interface": "#003A70",
    "method": "#0072B5",
    "namespace": "#0068A8",
    "parameter": "#3D4A55",
    "property": "#005580",
    "struct": "#003A70",
    "type": "#003A70",
    "typeParameter": "#0068A8",
    "variable": "#1F2933",
    "variable.readonly": "#1F2933"
  }
}
